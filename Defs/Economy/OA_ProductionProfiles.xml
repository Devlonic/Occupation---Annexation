<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		A town's output is a mix of these profiles, weighted by what it had when it was captured:
		baseWeight + weightPerBuilding * (matching buildings) + weightPerCrop * (sown crops).
		Amounts are per working adult per day, before loyalty, tax and the global multiplier.
		indicatorBuildings are ThingDef names (strings), so modded buildings can be added safely.
	-->

	<OccupationAnnexation.ProductionProfileDef>
		<defName>OA_Taxes</defName>
		<label>taxes</label>
		<baseWeight>1</baseWeight>
		<outputs>
			<li>
				<thing>Silver</thing>
				<perWorkerPerDay>4</perWorkerPerDay>
			</li>
		</outputs>
	</OccupationAnnexation.ProductionProfileDef>

	<OccupationAnnexation.ProductionProfileDef>
		<defName>OA_Farming</defName>
		<label>farming</label>
		<indicatorFields>true</indicatorFields>
		<weightPerCrop>0.03</weightPerCrop>
		<indicatorBuildings>
			<li>HydroponicsBasin</li>
		</indicatorBuildings>
		<outputs>
			<li>
				<thing>RawPotatoes</thing>
				<perWorkerPerDay>5</perWorkerPerDay>
			</li>
			<li>
				<thing>RawRice</thing>
				<perWorkerPerDay>5</perWorkerPerDay>
			</li>
			<li>
				<thing>RawCorn</thing>
				<perWorkerPerDay>3</perWorkerPerDay>
				<minTechLevel>Medieval</minTechLevel>
			</li>
			<li>
				<thing>Hay</thing>
				<perWorkerPerDay>3</perWorkerPerDay>
				<maxTechLevel>Medieval</maxTechLevel>
			</li>
		</outputs>
	</OccupationAnnexation.ProductionProfileDef>

	<OccupationAnnexation.ProductionProfileDef>
		<defName>OA_Kitchen</defName>
		<label>provisions</label>
		<weightPerBuilding>0.6</weightPerBuilding>
		<indicatorBuildings>
			<li>Campfire</li>
			<li>FueledStove</li>
			<li>ElectricStove</li>
			<li>TableButcher</li>
			<li>ButcherSpot</li>
		</indicatorBuildings>
		<outputs>
			<li>
				<thing>Pemmican</thing>
				<perWorkerPerDay>3</perWorkerPerDay>
				<maxTechLevel>Medieval</maxTechLevel>
			</li>
			<li>
				<thing>MealSimple</thing>
				<perWorkerPerDay>1.2</perWorkerPerDay>
				<minTechLevel>Industrial</minTechLevel>
			</li>
			<li>
				<thing>MealSurvivalPack</thing>
				<perWorkerPerDay>0.4</perWorkerPerDay>
				<minTechLevel>Spacer</minTechLevel>
			</li>
			<li>
				<thing>Kibble</thing>
				<perWorkerPerDay>2</perWorkerPerDay>
			</li>
		</outputs>
	</OccupationAnnexation.ProductionProfileDef>

	<OccupationAnnexation.ProductionProfileDef>
		<defName>OA_Smithing</defName>
		<label>crafting</label>
		<indicatorBuildings>
			<li>CraftingSpot</li>
			<li>FueledSmithy</li>
			<li>ElectricSmithy</li>
			<li>TableMachining</li>
			<li>FabricationBench</li>
		</indicatorBuildings>
		<outputs>
			<li>
				<thing>WoodLog</thing>
				<perWorkerPerDay>6</perWorkerPerDay>
				<maxTechLevel>Medieval</maxTechLevel>
			</li>
			<li>
				<thing>Steel</thing>
				<perWorkerPerDay>3</perWorkerPerDay>
				<minTechLevel>Medieval</minTechLevel>
			</li>
			<li>
				<thing>ComponentIndustrial</thing>
				<perWorkerPerDay>0.25</perWorkerPerDay>
				<minTechLevel>Industrial</minTechLevel>
			</li>
			<li>
				<thing>Plasteel</thing>
				<perWorkerPerDay>0.3</perWorkerPerDay>
				<minTechLevel>Spacer</minTechLevel>
			</li>
		</outputs>
	</OccupationAnnexation.ProductionProfileDef>

	<OccupationAnnexation.ProductionProfileDef>
		<defName>OA_Textiles</defName>
		<label>textiles</label>
		<indicatorBuildings>
			<li>HandTailoringBench</li>
			<li>ElectricTailoringBench</li>
		</indicatorBuildings>
		<outputs>
			<li>
				<thing>Cloth</thing>
				<perWorkerPerDay>5</perWorkerPerDay>
			</li>
			<li>
				<thing>Leather_Plain</thing>
				<perWorkerPerDay>2</perWorkerPerDay>
			</li>
		</outputs>
	</OccupationAnnexation.ProductionProfileDef>

	<OccupationAnnexation.ProductionProfileDef>
		<defName>OA_Luxuries</defName>
		<label>brewing and drugs</label>
		<indicatorBuildings>
			<li>Brewery</li>
			<li>DrugLab</li>
		</indicatorBuildings>
		<outputs>
			<li>
				<thing>Beer</thing>
				<perWorkerPerDay>2</perWorkerPerDay>
			</li>
			<li>
				<thing>SmokeleafJoint</thing>
				<perWorkerPerDay>1</perWorkerPerDay>
			</li>
		</outputs>
	</OccupationAnnexation.ProductionProfileDef>

	<OccupationAnnexation.ProductionProfileDef>
		<defName>OA_Medicine</defName>
		<label>medicine</label>
		<weightPerBuilding>0.5</weightPerBuilding>
		<indicatorBuildings>
			<li>DrugLab</li>
			<li>SimpleResearchBench</li>
			<li>HiTechResearchBench</li>
		</indicatorBuildings>
		<outputs>
			<li>
				<thing>MedicineHerbal</thing>
				<perWorkerPerDay>0.6</perWorkerPerDay>
				<maxTechLevel>Medieval</maxTechLevel>
			</li>
			<li>
				<thing>MedicineIndustrial</thing>
				<perWorkerPerDay>0.3</perWorkerPerDay>
				<minTechLevel>Industrial</minTechLevel>
			</li>
		</outputs>
	</OccupationAnnexation.ProductionProfileDef>

	<OccupationAnnexation.ProductionProfileDef>
		<defName>OA_Stonework</defName>
		<label>stonework and mining</label>
		<indicatorBuildings>
			<li>TableStonecutter</li>
			<li>ElectricSmelter</li>
			<li>DeepDrill</li>
		</indicatorBuildings>
		<outputs>
			<li>
				<thing>BlocksGranite</thing>
				<perWorkerPerDay>6</perWorkerPerDay>
			</li>
			<li>
				<thing>Steel</thing>
				<perWorkerPerDay>1.5</perWorkerPerDay>
				<minTechLevel>Industrial</minTechLevel>
			</li>
		</outputs>
	</OccupationAnnexation.ProductionProfileDef>

	<OccupationAnnexation.ProductionProfileDef>
		<defName>OA_Fuel</defName>
		<label>fuel</label>
		<indicatorBuildings>
			<li>BiofuelRefinery</li>
		</indicatorBuildings>
		<outputs>
			<li>
				<thing>Chemfuel</thing>
				<perWorkerPerDay>3</perWorkerPerDay>
				<minTechLevel>Industrial</minTechLevel>
			</li>
		</outputs>
	</OccupationAnnexation.ProductionProfileDef>

</Defs>
